{
  "name": "maverick-capital",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/website",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "dev:all": "npm run dev --workspace=apps/website & npm run dev:dashboard --workspace=apps/dashboard",
    "build": "npm run build --workspace=apps/website",
    "build:dashboard": "npm run build --workspace=apps/dashboard",
    "lint": "npm run lint --workspace=apps/website",
    "lint:dashboard": "npm run lint --workspace=apps/dashboard"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.101.4",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "@x402/svm": "^2.19.0",
    "moralis": "^2.27.2",
    "tronweb": "^6.4.0",
    "viem": "^2.55.8",
    "wagmi": "^3.7.4"
  }
}
